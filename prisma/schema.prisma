// ProfileForge — Prisma schema
// SQLite datasource; stores user-saved README presets.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Preset {
  id        String   @id @default(cuid())
  name      String
  config    String // JSON-stringified ProfileConfig
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
